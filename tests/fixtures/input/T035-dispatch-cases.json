      "expected": { "key": "é", "rawHex": "c3a9", "command": false }
    },
    {
      "id": "T035-UTF8-INVALID-01",
      "title": "Invalid partial UTF-8 becomes replacement text",
      "inputHex": ["c3", "41"],
      "expected": { "keys": ["�", "a"], "containsCommandChord": false }
    },
    {
      "id": "T035-OVERLAY-CANCEL-01",
      "title": "Escape cancels an overlay and restores valid prior focus",
      "sequence": ["g", "open-overlay", "escape"],
      "expected": { "activeFocus": "editor-main", "pending": [] }
    },
    {
      "id": "T035-AVAILABILITY-01",
