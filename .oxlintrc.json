{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    {
      "name": "xi",
      "specifier": "./tools/lint/xi-performance.mjs"
    }
  ],
  "rules": {
    "xi/performance": [
      "error",
      {
        "class": "C"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/document/**/*.ts",
        "packages/selections/**/*.ts",
        "packages/vim/**/*.ts",
        "packages/workbench/editing/**/*.ts",
        "packages/workbench/input/**/*.ts",
        "packages/workbench/vim-session/**/*.ts",
        "packages/workbench/pointer/**/*.ts",
        "packages/workbench/host/**/*.ts",
        "packages/ui/editor/**/*.ts",
        "packages/ui/input/**/*.ts",
        "packages/ui/src/**/*.ts",
        "packages/layout/**/*.ts"
      ],
      "rules": {
        "xi/performance": [
          "error",
          {
            "class": "H1"
          }
        ]
      }
    },
    {
      "files": [
        "packages/services/**/*.ts",
        "packages/vim/pattern/**/*.ts",
        "packages/vim/search/**/*.ts"
      ],
      "rules": {
        "xi/performance": [
          "error",
          {
            "class": "B"
          }
        ]
      }
    }
  ]
}
