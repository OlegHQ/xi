{
  "name": "xi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.13 <2"
  },
  "scripts": {
    "check": "bun run check:toolchain && bun run check:types && bun run check:public-boundary && bun run check:lint",
    "check:toolchain": "bun run ./tools/toolchain-check.ts",
    "check:types": "bun x tsc --noEmit",
    "check:public-boundary": "bun run ./tools/check-public-boundary.ts packages tools tests",
    "test:unit": "bun run ./tools/verify-suite.ts unit \"$@\"",
    "test:vim": "bun run ./tests/oracle/validate.ts \"$@\"",
    "oracle:fetch": "bun run ./tests/oracle/fetch-neovim.ts",
    "oracle:inventory": "bun run ./tests/oracle/build-inventory.ts",
    "test:services": "bun run ./tools/verify-suite.ts services \"$@\"",
    "test:ui": "bun run ./tools/verify-suite.ts ui \"$@\"",
    "test:e2e": "bun run ./tools/verify-suite.ts e2e \"$@\"",
    "bench": "bun run ./tools/verify-suite.ts bench \"$@\"",
    "xi": "bun run apps/xi/src/main.ts",
    "package:audit": "bun run ./tools/package-audit.ts --check",
    "package:build": "bun build --compile --bytecode --format=esm apps/xi/src/main.ts --outfile dist/xi",
    "package:release": "bun run ./tools/package-release.ts",
    "package:smoke": "bun run package:audit && python3 tests/distribution/t064-compiled-pty.py && python3 tests/distribution/t064-ex-pty.py",
    "spikes:render": "bun run ./spikes/render/probe.ts",
    "spikes:buffer": "bun run ./spikes/buffer/benchmark.ts",
    "verify:release": "bun run check && bun run test:unit && bun run test:vim -- --profile xi --suite multi-selection --seed 41027 && bun run test:services && bun run test:ui && bun run test:e2e -- --suite interaction && bun run bench -- --suite interaction --baseline revision",
    "check:lint": "bun run tools/lint/check.ts",
    "test:lint": "bun test --timeout 30000 tests/lint",
    "test:startup": "bun run package:build && bun test tests/distribution/t122-renderer-entry.test.ts && python3 tests/distribution/t122-startup-input.py"
  },
  "devDependencies": {
    "@opentui/core": "0.5.11",
    "@types/bun": "1.3.13",
    "@types/node": "26.5.1",
    "oxc-parser": "0.150.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "web-tree-sitter": "0.25.10",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.17.5"
  },
  "patchedDependencies": {
    "@opentui/core@0.5.11": "vendor/opentui/patches/opentui-core-0.5.11.patch"
  }
}
